{
  "name": "DGO Correspondence Mailer",
  "package": "dgo-correspondence-mailer",
  "version": "2.1.5",
  "contractVersion": "dgo-mail/2.0",
  "requires": "Node.js 18+ only to run tools/ locally; the web/ folder is static and needs no runtime.",
  "flows": [
    {
      "name": "DGO_MAIL_SEND",
      "endpointKey": "MAIL_SEND",
      "package": "flows/packages/DGO_MAIL_SEND.zip",
      "trigger": "HTTP request",
      "operations": [
        "send",
        "healthCheck",
        "verify"
      ]
    },
    {
      "name": "DGO_MAIL_LOG",
      "endpointKey": "MAIL_LOG",
      "package": "flows/packages/DGO_MAIL_LOG.zip",
      "trigger": "HTTP request",
      "operations": [
        "list",
        "get",
        "healthCheck",
        "verify"
      ]
    },
    {
      "name": "DGO_MAIL_DIRECTORY",
      "endpointKey": "MAIL_DIRECTORY",
      "package": "flows/packages/DGO_MAIL_DIRECTORY.zip",
      "trigger": "HTTP request",
      "operations": [
        "list",
        "upsert",
        "delete",
        "healthCheck",
        "verify"
      ]
    },
    {
      "name": "DGO_MAIL_TEMPLATES",
      "endpointKey": "MAIL_TEMPLATES",
      "package": "flows/packages/DGO_MAIL_TEMPLATES.zip",
      "trigger": "HTTP request",
      "operations": [
        "list",
        "upsert",
        "delete",
        "healthCheck",
        "verify"
      ]
    },
    {
      "name": "DGO_MAIL_PROVISION",
      "endpointKey": "MAIL_PROVISION",
      "package": "flows/packages/DGO_MAIL_PROVISION.zip",
      "trigger": "HTTP request",
      "operations": [
        "provision",
        "healthCheck",
        "verify"
      ]
    },
    {
      "name": "DGO_MAIL_AUTH",
      "endpointKey": "MAIL_AUTH",
      "package": "flows/packages/DGO_MAIL_AUTH.zip",
      "trigger": "HTTP request",
      "operations": [
        "requestCode",
        "verifyCode",
        "signOut",
        "whoAmI",
        "listOperators",
        "upsertOperator",
        "healthCheck",
        "verify"
      ]
    },
    {
      "name": "DGO_MAIL_DATA",
      "endpointKey": "MAIL_DATA",
      "package": "flows/packages/DGO_MAIL_DATA.zip",
      "trigger": "HTTP request",
      "operations": [
        "listMailings",
        "saveMailing",
        "deleteMailing",
        "listReports",
        "saveReport",
        "deleteReport",
        "uploadFile",
        "downloadFile",
        "listFiles",
        "deleteFile",
        "healthCheck",
        "verify"
      ]
    }
  ],
  "sharePointLists": [
    "DGOMailLog",
    "DGOMailDirectory",
    "DGOMailTemplates",
    "DGOMailOperators",
    "DGOMailSessions",
    "DGOMailCampaigns",
    "DGOMailReports",
    "DGOMailFiles"
  ],
