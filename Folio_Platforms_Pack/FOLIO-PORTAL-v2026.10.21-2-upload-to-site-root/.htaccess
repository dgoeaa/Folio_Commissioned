# NITDA Document Portal: host rules for the site root of folio-portal.page.gd.
#
# Pages, scripts, styles and config.local.js are revalidated on every load, so a new release or a
# rotated endpoint reaches returning visitors at once (the host default was a 30-day cache). Images
# and fonts keep the host's caching. Unknown addresses get the portal's own 404 page. The security
# headers stop other sites framing the portal, stop content-type sniffing, and limit what the pages
# may load and connect to. Every header rule sits inside IfModule, as in the Workspace's .htaccess on
# the same host, so a server without the module skips the rule instead of failing.
#
# Plain HTTP is moved to HTTPS by the first line of each page's head script. This host makes every
# visitor run JavaScript before it serves a page, so that reaches every visitor, and it cannot loop
# the way a server-side rewrite can behind the host's TLS proxy.

ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html?|js|css|json|webmanifest|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Qs3Y8LLHNfRgwN1Pu/yhh9O6AmxEZXBliiRaieQXSkc=' 'unsafe-hashes' 'sha256-yyjq/GGlTvm0YhdkNx72uPxcwaIXqWZBYZftmpA6pYU='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.environment.api.powerplatform.com https://*.logic.azure.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>

<IfModule mod_expires.c>
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"
</IfModule>
